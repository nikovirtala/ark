{
  "name": "@nikovirtala/issues",
  "version": "0.5.1",
  "description": "Issue tracking kept as event logs in git: computed state, blockers and duplicates, relations and links to adr decisions. CLI and library.",
  "keywords": [
    "issues",
    "issue-tracker",
    "git",
    "event-sourcing",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nikovirtala/ark/tree/main/packages/issues#readme",
  "bugs": "https://github.com/nikovirtala/ark/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikovirtala/ark.git",
    "directory": "packages/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "issues": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kind": {
      "types": "./dist/types/kind.d.ts",
      "default": "./dist/kind.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@nikovirtala/adr": "workspace:^",
    "@nikovirtala/ledger": "workspace:^"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "clean": "rm -rf dist"
  }
}
