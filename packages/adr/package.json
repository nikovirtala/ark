{
  "name": "@nikovirtala/adr",
  "version": "0.2.0",
  "description": "Architecture decision records kept as event logs in git: frozen bodies, computed status and supersession chains. CLI and library.",
  "keywords": [
    "adr",
    "architecture-decision-records",
    "git",
    "event-sourcing",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nikovirtala/ark/tree/main/packages/adr#readme",
  "bugs": "https://github.com/nikovirtala/ark/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikovirtala/ark.git",
    "directory": "packages/adr"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "adr": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kind": {
      "types": "./dist/types/kind.d.ts",
      "default": "./dist/kind.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@nikovirtala/ledger": "workspace:^"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "clean": "rm -rf dist"
  }
}
