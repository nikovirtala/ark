{
  "name": "@nikovirtala/deployment",
  "version": "0.0.0",
  "description": "Deploy a project's environment from its pipeline: check, deploy with rollback triggers, smoke checks, one-off deployment tasks run once, and a freeze on failure. CLI and library.",
  "keywords": [
    "deployment",
    "pipeline",
    "aws",
    "cdk",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nikovirtala/ark/tree/main/packages/deployment#readme",
  "bugs": "https://github.com/nikovirtala/ark/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikovirtala/ark.git",
    "directory": "packages/deployment"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "deploy": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cdk": {
      "types": "./dist/types/cdk/index.d.ts",
      "default": "./dist/cdk.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1173.0",
    "@aws-sdk/client-ssm": "3.1173.0",
    "@aws-sdk/lib-dynamodb": "3.1173.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "aws-cdk": "2.1149.0",
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1"
  }
}
