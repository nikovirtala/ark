{
  "name": "ark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm -r run build",
    "typecheck": "tsc -b",
    "lint": "biome check . && node scripts/check-test-inputs.mjs",
    "format": "biome check --write .",
    "test": "pnpm -r run test",
    "check": "pnpm lint && pnpm build && pnpm test",
    "check:commit": "scripts/check-commit.sh",
    "clean": "pnpm -r run clean",
    "changeset": "changeset",
    "git-hooks": "node scripts/git-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nikovirtala/adr": "workspace:*",
    "@nikovirtala/issues": "workspace:*",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
