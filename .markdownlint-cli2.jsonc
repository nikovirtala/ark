// markdownlint-cli2 configuration for ark.
// Goal: lock in Markdown quality for human- and agent-facing docs going
// forward, without churning the existing design docs or the Markdown that
// ark's own tools (adr, issues) and Changesets generate.
{
  // Generated or vendored Markdown is not hand-edited, so it is not linted.
  "ignores": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    // Event-sourced records and committed indexes managed by ark's own tools.
    "docs/adr/**",
    "docs/issues/**",
    // Release notes generated by Changesets.
    "**/CHANGELOG.md",
    ".changeset/README.md"
  ],
  "config": {
    // Keep the default ruleset, then relax the rules that fight prose and the
    // repo's existing, intentional style rather than mass-editing the docs.

    // Prose is wrapped by meaning, not by column, across this repo.
    "MD013": false,
    // Inline HTML is used deliberately (e.g. details/summary, anchors, badges).
    "MD033": false,
    // Bare URLs appear in reference material; link text is enforced elsewhere.
    "MD034": false,
    // Duplicate headings are expected across sibling sections and tables.
    "MD024": false,
    // Table pipe spacing style is left to the author / formatter.
    "MD060": false,
    // First line need not be a top-level heading (front matter, badges, intros).
    "MD041": false,
    // Emphasis is sometimes used as a lightweight lead-in, not a heading.
    "MD036": false,
    // Ordered-list numbering style is left to the author.
    "MD029": false,
    // Some fenced blocks show directory trees or plain output, where a
    // programming-language tag would be artificial.
    "MD040": false,
    // Code spans intentionally show literal spacing, e.g. a `# ` heading prefix.
    "MD038": false
  }
}
