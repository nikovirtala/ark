{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/before-edit.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(docs/*/events/**)",
      "Write(docs/*/events/**)",
      "Edit(docs/*/index.md)",
      "Write(docs/*/index.md)",
      "Edit(docs/adr/decisions/**)",
      "Write(docs/adr/decisions/**)"
    ]
  }
}
