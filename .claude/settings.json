{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/before-edit.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/docs/adr/events/**)",
      "Edit(/docs/adr/index.md)",
      "Edit(/docs/adr/decisions/**)",
      "Edit(/docs/issues/events/**)",
      "Edit(/docs/issues/index.md)"
    ]
  }
}
